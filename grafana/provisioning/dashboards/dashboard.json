    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 43 },
      "id": 20,
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "title": "Live Application Log Stream",
      "type": "logs",
      "targets": [
        {
          "expr": "{container=~\"app|postgres|redis|nginx|node\"}",
